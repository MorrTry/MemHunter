#include <winres.h>

1 ICON "memhunter.ico"
// Resource 2, not 1: the MinGW runtime links its default manifest as resource 1, and main.cpp activates this one.
2 RT_MANIFEST "memhunter_gui.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "MemHunter - process memory search"
      VALUE "ProductName", "MemHunter"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
      VALUE "OriginalFilename", "memhunter_gui.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
